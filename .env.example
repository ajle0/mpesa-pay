# Copy to .env and edit:   cp .env.example .env   (Windows: copy .env.example .env)

# ---------------------------------------------------------------- Django
DEBUG=1
# Required when DEBUG=0. Generate: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1
SITE_NAME=QuickPay
# Leave unset to use SQLite. Docker Compose sets this to its Postgres automatically.
# DATABASE_URL=postgres://user:password@host:5432/dbname

# First admin account, created on startup if it doesn't exist (Docker only;
# without Docker run: python manage.py createsuperuser). Change the password!
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-please
ADMIN_EMAIL=

# ---------------------------------------------------------------- M-Pesa
# simulate   = no Safaricom calls; buttons on the page fake the outcome (DEBUG only)
# sandbox    = Safaricom sandbox, test money (needs the keys below + a public URL)
# production = real money
MPESA_MODE=simulate

# From https://developer.safaricom.co.ke -> My Apps
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=

# Sandbox values below are Safaricom's public test shortcode and passkey.
MPESA_SHORTCODE=174379
MPESA_PASSKEY=bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919

# CustomerPayBillOnline for a paybill, CustomerBuyGoodsOnline for a till.
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
# Till only: the till number (MPESA_SHORTCODE is then your store number). Blank = shortcode.
MPESA_PARTY_B=

# Shown on the customer's M-Pesa prompt (max 12 / 13 characters).
MPESA_ACCOUNT_REFERENCE=QuickPay
MPESA_TRANSACTION_DESC=Payment

# Public HTTPS address Safaricom can reach, e.g. your free static ngrok domain:
# https://your-name.ngrok-free.app   (no trailing slash)
MPESA_CALLBACK_BASE_URL=
# Long random string hidden in the callback path. Required outside simulate mode.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
MPESA_CALLBACK_SECRET=

# Only needed for `docker compose --profile tunnel up` (https://dashboard.ngrok.com)
NGROK_AUTHTOKEN=

# ---------------------------------------------------------------- Amounts
# Whole shillings the customer may enter. M-Pesa's own cap is 250,000 per transaction.
PAY_MIN_AMOUNT=1
PAY_MAX_AMOUNT=250000

# ---------------------------------------------------------------- Abuse limits
PAY_RATE_LIMIT_PER_PHONE=3
PAY_RATE_LIMIT_PER_IP=10
PAY_RATE_LIMIT_WINDOW_MINUTES=5
PAY_PENDING_EXPIRY_SECONDS=180
# Set to 1 only behind a proxy you control (Render, Railway, nginx).
USE_X_FORWARDED_FOR=0
